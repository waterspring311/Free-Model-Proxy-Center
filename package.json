{
  "name": "onehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node server/main.mjs --dev",
    "start": "node server/main.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",

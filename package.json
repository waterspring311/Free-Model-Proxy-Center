    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "8.3.4"
  }
}
